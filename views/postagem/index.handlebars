<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <a href="/" class="text-muted small text-decoration-none">
        <i class="bi bi-arrow-left me-1"></i>Voltar para o inicio
      </a>

      <div class="card border shadow-none rounded-3 mt-3">
        <div class="card-body p-4 p-md-5">

          <span class="badge bg-dark rounded-pill mb-3">
            <i class="bi bi-tag me-1"></i>{{postagem.categoria.nome}}
          </span>

          <h1 class="fs-3 fw-medium mb-3">{{postagem.titulo}}</h1>
          <hr>

          <div class="conteudo lh-lg">
            {{postagem.conteudo}}
    
       <div class="d-flex align-items-center justify-content-between mt-4 pt-4 border-top">
          <small class="text-muted">
            <i class="bi bi-calendar3 me-1"></i>{{formatDate postagem.date}}
          </small>

          {{#if user}}
            <form action="/postagens/{{postagem.slug}}/like" method="POST">
              <button type="submit" style="background: none; border: none; padding: 0; cursor: pointer;">
                <i class="bi bi-hand-thumbs-up{{#if jaLikeu}}-fill{{/if}} fs-5 {{#if jaLikeu}}text-primary{{else}}text-muted{{/if}}"></i>
                <small class="{{#if jaLikeu}}text-dark{{else}}text-muted{{/if}}">Útil ({{postagem.likes.length}})</small>
              </button>
            </form>
          {{else}}
            <a href="/usuario/login" class="text-decoration-none">
              <i class="bi bi-hand-thumbs-up fs-5 text-muted"></i>
              <small class="text-muted">Útil ({{postagem.likes.length}})</small>
            </a>
          {{/if}}
        </div>


          </div>

        </div>
      </div>

    </div>
  </div>
</div>
