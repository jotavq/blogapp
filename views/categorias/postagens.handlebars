<div class="container py-5">

  <div class="mb-5">
    <a href="/categorias" class="text-muted small text-decoration-none">
      <i class="bi bi-arrow-left me-1"></i>Voltar para categorias
    </a>
    <h1 class="fs-3 fw-medium mt-3 mb-1">{{categoria.nome}}</h1>
    <p class="text-muted small mb-0">Postagens nessa categoria</p>
    <hr>
  </div>

  <div class="row g-4">
    {{#each postagens}}
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 border shadow-none rounded-3">
        <div class="card-body d-flex flex-column p-4">

          <h3 class="fs-5 fw-medium mb-2">{{titulo}}</h3>
          <p class="text-muted small flex-grow-1 mb-3">{{descricao}}</p>

          <div class="d-flex align-items-center justify-content-between mt-auto pt-3 border-top">
            <small class="text-muted">
              <i class="bi bi-calendar3 me-1"></i>{{formatDate date}}
            </small>
            <a href="/postagens/{{slug}}" class="btn btn-dark btn-sm px-3">
              Leia mais <i class="bi bi-arrow-right ms-1"></i>
            </a>
          </div>

        </div>
      </div>
    </div>
    {{else}}
    <div class="col-12">
      <div class="text-center py-5 text-muted">
        <i class="bi bi-journal-x fs-1 d-block mb-3"></i>
        <h5 class="fw-medium">Nenhuma postagem encontrada</h5>
        <p class="small mb-0">Ainda não há postagens nessa categoria.</p>
      </div>
    </div>
    {{/each}}
  </div>

</div>
