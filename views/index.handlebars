<div class="container py-5">

  <!-- Hero -->
  <div class="p-5 mb-5 bg-dark text-light rounded-4 shadow">
    <div class="container-fluid py-3">
      <h1 class="display-5 fw-bold mb-3">Bem-vindo ao BlogStack</h1>
      <p class="col-md-8 fs-5 text-secondary mb-4">
        Crie, gerencie e publique suas postagens facilmente com um sistema de blog moderno.
      </p>
      <div class="d-flex gap-2 flex-wrap">
        {{#unless user}}
        <a href="/usuario/registro" class="btn btn-primary btn-lg">
          <i class="bi bi-person-plus me-2"></i>Crie uma conta
        </a>
        {{/unless}}
        <a href="/categorias" class="btn btn-outline-light btn-lg">
          <i class="bi bi-grid me-2"></i>Ver categorias
        </a>
      </div>
    </div>
  </div>

  <!-- Postagens -->
  <div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="fs-4 fw-medium mb-0">Postagens recentes</h2>
    <a href="/categorias" class="text-muted small text-decoration-none">
      Ver por categoria <i class="bi bi-arrow-right"></i>
    </a>
  </div>

  <div class="row g-4">
    {{#each postagens}}
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 border shadow-none rounded-3">
        <div class="card-body d-flex flex-column p-4">

          <span class="badge bg-dark rounded-pill mb-3 align-self-start">
            <i class="bi bi-tag me-1"></i>{{categoria.nome}}
          </span>

          <h3 class="fs-5 fw-medium mb-2">{{titulo}}</h3>
          <p class="text-muted small flex-grow-1 mb-3">{{descricao}}</p>

          <div class="d-flex align-items-center justify-content-between mt-auto pt-3 border-top">
            <div class="d-flex align-items-center gap-3">
              <small class="text-muted">
                <i class="bi bi-calendar3 me-1"></i>{{formatDate date}}
              </small>
              <small class="text-muted">
                <i class="bi bi-hand-thumbs-up me-1"></i>{{likes.length}}
              </small>
            </div>
            <a href="/postagens/{{slug}}" class="btn btn-dark btn-sm px-3">
              Leia mais <i class="bi bi-arrow-right ms-1"></i>
            </a>
          </div>

        </div>
      </div>
    </div>
    {{else}}
    <div class="col-12">
      <div class="text-center py-5 text-muted">
        <i class="bi bi-journal-x fs-1 d-block mb-3"></i>
        <h5 class="fw-medium">Nenhuma postagem encontrada</h5>
        <p class="small mb-0">Volte em breve para novos conteúdos.</p>
      </div>
    </div>
    {{/each}}
  </div>

</div>