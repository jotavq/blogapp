<div class="d-flex align-items-center justify-content-center mt-5">
  <div class="w-100" style="max-width: 380px; padding: 0 1rem;">

    <div class="text-center mb-4">
      <div class="bg-primary bg-opacity-10 rounded-3 d-inline-flex align-items-center justify-content-center mb-3" style="width:48px; height:48px;">
        <i class="bi bi-feather fs-5 text-primary"></i>
      </div>
      <h1 class="fs-5 fw-medium mb-1">Bem-vindo de volta</h1>
      <p class="text-muted small mb-0">Entre na sua conta para continuar</p>
    </div>

    <div class="card border shadow-none p-2">
      <div class="card-body">

        <form action="/usuario/login" method="post">

          <div class="mb-3">
            <label for="email" class="form-label small fw-medium text-secondary">Email</label>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0">
                <i class="bi bi-envelope text-muted"></i>
              </span>
              <input type="email" class="form-control border-start-0 bg-light" id="email" name="email" placeholder="seu@email.com" required>
            </div>
          </div>

          <div class="mb-4">
            <label for="senha" class="form-label small fw-medium text-secondary">Senha</label>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0">
                <i class="bi bi-lock text-muted"></i>
              </span>
              <input type="password" class="form-control border-start-0 bg-light" id="senha" name="senha" placeholder="••••••••" required>
            </div>
          </div>

          <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2">
            <i class="bi bi-box-arrow-in-right"></i> Entrar
          </button>

        </form>
      </div>
    </div>

    <p class="text-center text-muted small mt-3 mb-0">
      Não tem uma conta?
      <a href="/usuario/registro" class="text-primary fw-medium text-decoration-none">Criar conta</a>
    </p>

  </div>
</div>